{
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./zero-ring-landing-page/zero-ring-landing-page/*"
            ],
            "react": [
                "./zero-ring-landing-page/zero-ring-landing-page/node_modules/@types/react"
            ],
            "react-dom": [
                "./zero-ring-landing-page/zero-ring-landing-page/node_modules/@types/react-dom"
            ]
        },
        "typeRoots": [
            "./zero-ring-landing-page/zero-ring-landing-page/node_modules/@types"
        ]
    },
    "include": [
        "**/*.tsx",
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules"
    ]
}